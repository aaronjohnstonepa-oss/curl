<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
header validation
</keywords>
</info>

<reply>
# A colon-less line after a leading CR was accepted as the empty-line
# terminator even though normal header validation rejects such lines.
<data nocheck="yes">
HTTP/1.1 200 OK%CR
Content-Length: 0%CR
%CRBad line without colon%CR
</data>
</reply>

<client>
<server>
http
</server>
<name>
Reject a non-empty CR-prefixed HTTP header terminator
</name>
<command option="no-output,no-include">
-D %LOGDIR/heads%TESTNUMBER -o /dev/null http://%HOSTIP:%HTTPPORT/%TESTNUMBER
</command>
</client>

<verify>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

</protocol>
<errorcode>
8
</errorcode>
<file name="%LOGDIR/heads%TESTNUMBER" crlf="yes">
HTTP/1.1 200 OK
Content-Length: 0
</file>
</verify>
</testcase>
